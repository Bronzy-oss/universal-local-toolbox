{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Local Toolbox",
  "version": "0.1.0",
  "identifier": "com.bronzy.universallocaltoolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Local Toolbox",
        "width": 400,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
